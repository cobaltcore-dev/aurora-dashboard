{
  "name": "@cobaltcore-dev/aurora-dashboard",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@cobaltcore-dev/dashboard",
    "preview": "turbo build --filter=@cobaltcore-dev/dashboard && pnpm --filter=@cobaltcore-dev/dashboard preview",
    "check-i18n": "turbo check-i18n",
    "commit": "cz",
    "commit:check": "./scripts/check-commit-msg.sh",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test",
    "test:e2e": "turbo test:e2e --filter=@cobaltcore-dev/dashboard",
    "test:e2e:ui": "pnpm --filter=@cobaltcore-dev/dashboard test:e2e:ui",
    "test:e2e:headed": "pnpm --filter=@cobaltcore-dev/dashboard test:e2e:headed",
    "test:e2e:debug": "pnpm --filter=@cobaltcore-dev/dashboard test:e2e:debug",
    "test:e2e:report": "pnpm --filter=@cobaltcore-dev/dashboard test:e2e:report",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "format:check": "prettier --config ./.prettierrc --check \"**/*.{js,jsx,ts,tsx,md}\" ",
    "licenses:check": "npx license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BSD-4-Clause;CC-BY-3.0;CC-BY-4.0;BlueOak-1.0.0;CC0-1.0;0BSD;Python-2.0;BSD*;Unlicense'",
    "clean:vite": "find . -type f -name 'vite.config.*.timestamp-*' -ls -delete 2>/dev/null",
    "clean": "pnpm run clean:vite && turbo run clean && rm -rf node_modules",
    "clean:cache": "turbo run clean:cache && rm -rf .turbo && rm -rf node_modules/.cache/turbo",
    "generate:package": "turbo gen workspace --type package --copy @cobalcore-dev/aurora-package-template --name",
    "prepare": "husky",
    "release": "changeset publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "cz-customizable": "^7.5.1",
    "eslint": "^10.7.0",
    "husky": "^9.1.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6"
  },
  "packageManager": "pnpm@11.20.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "js-yaml": ">=4.3.0"
    }
  }
}
