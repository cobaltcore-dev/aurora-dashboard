{
  "name": "@cobaltcore-dev/aurora-key-manager",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist && rm -rf .turbo",
    "clean:cache": "rm -rf .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@cobaltcore-dev/aurora": "workspace:*",
    "@tanstack/react-router": ">=1",
    "react": ">=19"
  },
  "dependencies": {
    "@cloudoperators/juno-ui-components": "9.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cobaltcore-dev/aurora": "workspace:*",
    "@cobaltcore-dev/aurora-config": "workspace:*",
    "@tanstack/react-router": "^1.0.0",
    "@trpc/server": "11.16.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
