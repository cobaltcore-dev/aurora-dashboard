{
  "extends": "@cobaltcore-dev/aurora-config/typescript/tsconfig.lib.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "rootDir": "src/server",
    "outDir": "dist/server",
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/server"],
  "exclude": ["src/client", "node_modules", "dist"]
}
