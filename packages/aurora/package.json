{
  "name": "@cobaltcore-dev/aurora",
  "version": "1.1.0",
  "private": false,
  "description": "Aurora OpenStack dashboard — server and client library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobaltcore-dev/aurora-dashboard.git",
    "directory": "packages/aurora"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/server/index.js",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:client": "vite build --mode=production",
    "build:server": "tsup",
    "prepublishOnly": "pnpm build",
    "check-i18n": "lingui extract --clean && lingui compile --typescript --verbose",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
    "clean:cache": "rm -rf .turbo",
    "compile": "lingui compile --typescript --verbose",
    "extract": "lingui extract --clean",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@headlessui/react": "^2.0.0",
    "@lingui/core": "^5.0.0",
    "@lingui/react": "^5.0.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@trpc/react-query": "^11.0.0",
    "fastify": "^5.0.0",
    "focus-trap-react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-icons": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/lib-storage": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@trpc/client": "11.16.0",
    "@trpc/server": "11.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify-plugin": "^5.1.0",
    "node-fetch": "^3.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudoperators/juno-ui-components": "9.4.0",
    "@cobaltcore-dev/aurora-config": "workspace:*",
    "@cobaltcore-dev/policy-engine": "workspace:*",
    "@cobaltcore-dev/signal-openstack": "workspace:*",
    "@fastify/vite": "^8.4.1",
    "@lingui/cli": "^5.9.5",
    "@lingui/format-po": "^5.9.5",
    "@lingui/swc-plugin": "^5.11.0",
    "@lingui/vite-plugin": "^5.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fastify": "^5.12.1",
    "globals": "^17.8.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
