{
  "extends": "@cobaltcore-dev/aurora-config/typescript/tsconfig.lib.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
